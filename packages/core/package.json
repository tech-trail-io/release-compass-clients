{
  "name": "@techtrail/release-compass-core",
  "version": "0.0.1",
  "description": "Framework-agnostic Release Compass API client for public embeds and server-side tokens",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "homepage": "https://github.com/tech-trail-io/release-compass-clients#readme",
  "bugs": {
    "url": "https://github.com/tech-trail-io/release-compass-clients/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tech-trail-io/release-compass-clients.git",
    "directory": "packages/core"
  }
}
